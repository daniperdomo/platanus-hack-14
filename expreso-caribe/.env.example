# Web de ZeroID: de aquí se carga el SDK (/sdk/zeroid.js) y se abre la ventana de inicio de sesión.
NEXT_PUBLIC_ZEROID_URL=http://localhost:3000
# Backend de ZeroID. Solo lo usa el servidor de este sitio para canjear el inicio de sesión.
ZEROID_API_URL=http://localhost:8000

# Credenciales de Expreso Caribe. Se generan con `python -m scripts.demo_client` desde backend/.
NEXT_PUBLIC_ZEROID_CLIENT_ID=
ZEROID_CLIENT_SECRET=
