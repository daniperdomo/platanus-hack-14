# Neon: `neon env pull --file backend/.env` escribe ambas. DATABASE_URL es la conexión con pooler
# (tráfico de la app); DATABASE_URL_UNPOOLED es la directa que usa init_db para el esquema.
# Vacía = init_db usa DATABASE_URL (Postgres local).
DATABASE_URL=postgresql://zeroid:zeroid@localhost:5432/zeroid
DATABASE_URL_UNPOOLED=
# Obligatoria: llave RSA privada en PEM (puede ir en una línea con \n). Sin ella el servidor no arranca.
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
JWT_PRIVATE_KEY=
# Obligatorio: secreto largo y aleatorio. El servidor no arranca con el valor por defecto ni con este ejemplo.
# openssl rand -hex 32
HASH_PEPPER=cambia-esto-por-otro-secreto-largo
CORS_ORIGINS=http://localhost:3000
# Usa un proyecto con facturación activa: en el plan gratuito Google puede usar las imágenes para entrenar.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# true = /document/check devuelve los datos leídos de la MRZ. Solo para depurar en local.
DEBUG_PASSPORT=false
